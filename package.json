{
  "name": "maiaos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MaiaOS architecture and desktop proof of concept",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:kernel": "bash scripts/build-kernel-wasm.sh",
    "build:apps": "bash scripts/build-calculator-wasm.sh && bash scripts/build-clock-wasm.sh",
    "build:shell": "bash scripts/build-shell-wasm.sh",
    "build:lvgl": "bash scripts/build-lvgl-wasm.sh",
    "test:shell-grammar": "bash scripts/test-shell-grammar.sh",
    "test:shell-parser": "node scripts/test-shell-generated-parser.mjs",
    "test:shell-equivalence": "node scripts/test-shell-equivalence.mjs",
    "benchmark:shell-parser": "node scripts/benchmark-shell-frontends.mjs",
    "test:shell-host": "node scripts/test-shell-host.mjs",
    "test:shell-lvgl": "node scripts/test-shell-host.mjs --lvgl",
    "test:lvgl-host": "node scripts/test-lvgl-host.mjs",
    "demo": "node platform/desktop-web/server.js",
    "build:cat": "node scripts/build-cat-wasm.mjs",
    "test:kernel-processes-native": "node scripts/test-kernel-processes-native.mjs",
    "test:kernel-processes": "node scripts/test-kernel-processes.mjs",
    "test:pipeline-workers": "node scripts/test-pipeline-workers.mjs",
    "test:shell-pipelines": "node scripts/test-shell-pipelines.mjs",
    "build:io": "node scripts/build-io-wasm.mjs",
    "test:io-streams": "node scripts/test-io-streams.mjs",
    "test:shell-boot": "node scripts/test-shell-boot.mjs",
    "test:shell-directories": "node scripts/test-shell-directories.mjs",
    "test:shell-files": "node scripts/test-shell-files.mjs",
    "test:shell-redirection": "node scripts/test-shell-redirection.mjs",
    "test:shell-glob": "node scripts/test-shell-glob.mjs"
  }
}
