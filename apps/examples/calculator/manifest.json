{
  "schema": 1,
  "id": "org.maiaplatform.calculator",
  "name": "Maia Calculator",
  "version": "0.1.0",
  "entry": "app.wasm",
  "entryExport": "maia_app_start",
  "stepExport": "maiaos_step",
  "abi": "maiaos-0",
  "wasmProfile": "maiaos-embedded-v0",
  "capabilities": [
    "gfx.window",
    "gfx.label",
    "gfx.label.set_text",
    "gfx.button",
    "events.poll",
    "process.exit"
  ],
  "limits": {
    "memoryPages": 32,
    "openFiles": 4
  }
}
